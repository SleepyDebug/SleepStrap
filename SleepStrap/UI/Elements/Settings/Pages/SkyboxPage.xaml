<ui:UiPage x:Class="SleepStrap.UI.Elements.Settings.Pages.SkyboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dmodels="clr-namespace:SleepStrap.UI.ViewModels.Settings"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance dmodels:SkyboxViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="760" d:DesignWidth="800" Title="Skybox" Scrollable="True">
    <ui:UiPage.Resources>
        <Style x:Key="SkyboxActionButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7F101012" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D93C3C40" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:UiPage.Resources>
    <StackPanel Margin="0,0,14,20">
        <Border Padding="18,14,18,12" CornerRadius="14" BorderThickness="0" Background="#C40A0A0C">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Skybox" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="WeatherMoon24" FontSize="34" Foreground="White" Opacity="0.72" />
                </Grid>
                <Border Grid.Row="1" Margin="0,12,0,0" Height="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="#CFFFFFFF" Offset="0.5" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
            </Grid>
        </Border>

        <ui:CardExpander Margin="0,14,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skybox library" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the sky used when Roblox launches" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ProgressRing Grid.Column="1" Width="22" Height="22" Margin="12,0" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </ui:CardExpander.Header>
            <Border Padding="8" Background="Transparent">
            <ListBox x:Name="SkyboxList" Height="500"
                     ItemsSource="{Binding SkyboxChoices}"
                     SelectedItem="{Binding SelectedSkybox, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1"
                                BorderBrush="#3DFFFFFF" Background="#B30A0A0C" ClipToBounds="True"
                                PreviewMouseLeftButtonDown="SkyCard_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SkyCard_MouseLeftButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="118" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Border x:Name="PreviewImage" CornerRadius="9,9,0,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="NonePreview" CornerRadius="9,9,0,0" Visibility="Collapsed">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#303033" Offset="0" /><GradientStop Color="#111113" Offset="1" /></LinearGradientBrush></Border.Background>
                                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="58" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="8,0">
                                    <TextBlock x:Name="SkyName" Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="RenameSkyboxBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Visibility="Collapsed" KeyDown="RenameSkyboxBox_KeyDown"
                                             LostKeyboardFocus="RenameSkyboxBox_LostKeyboardFocus" />
                                </Grid>
                                <Button x:Name="FavoriteBadge" Content="★" Tag="{Binding}" Click="FavoriteStar_Click"
                                        Width="28" Height="28" Margin="8" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#E6FFFFFF" BorderThickness="0" Foreground="Black" FontSize="16"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Panel.ZIndex="8" />
                                <Border x:Name="SelectedBadge" Grid.RowSpan="2" Width="28" Height="28" Margin="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="9"
                                        Background="#E6FFFFFF" Visibility="Collapsed" Panel.ZIndex="7">
                                    <ui:SymbolIcon Symbol="Checkmark24" Foreground="Black" FontSize="17" />
                                </Border>
                                <Border x:Name="UserSkyActions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="3"
                                        CornerRadius="8" Background="#D9101012" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SkyboxActionButton}" ToolTip="Rename custom skybox" Click="RenameUserSkybox_Click">
                                            <ui:SymbolIcon Symbol="Rename24" />
                                        </Button>
                                        <Button Style="{StaticResource SkyboxActionButton}" ToolTip="Delete custom skybox" Click="DeleteUserSkybox_Click">
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNone}" Value="True">
                                <Setter TargetName="PreviewImage" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NonePreview" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="SkyName" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="RenameSkyboxBox" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUserImported}" Value="True">
                                <Setter TargetName="UserSkyActions" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsUserImported}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Card}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="UserSkyActions" Property="Opacity" Value="1" />
                                <Setter TargetName="UserSkyActions" Property="IsHitTestVisible" Value="True" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#E6FFFFFF" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Border>
        </ui:CardExpander>
    </StackPanel>
</ui:UiPage>
