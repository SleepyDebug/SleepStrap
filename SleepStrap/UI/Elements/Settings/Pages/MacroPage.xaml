<ui:UiPage x:Class="SleepStrap.UI.Elements.Settings.Pages.MacroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dmodels="clr-namespace:SleepStrap.UI.ViewModels.Settings"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance dmodels:MacroViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="700" d:DesignWidth="800" Title="Macro" Scrollable="True">

    <ui:UiPage.Resources>
        <DataTemplate x:Key="WeaponChoiceTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="7" ClipToBounds="True"
                        Background="#18000000">
                    <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SlotText}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CalibrationWeaponTemplate">
            <ToggleButton IsChecked="{Binding IsMissing, Mode=TwoWay}"
                          Width="112" Height="104" Margin="4" Padding="0"
                          ToolTip="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="5,5,5,2" CornerRadius="10" ClipToBounds="True"
                            Background="#18000000">
                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="4,2,4,4"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="11" VerticalAlignment="Center" />
                    <Border Grid.RowSpan="2" CornerRadius="8" Background="#B0000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="24"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="Not owned" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ToggleButton>
        </DataTemplate>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,20">
        <Border Padding="18,14,18,12" CornerRadius="14" BorderThickness="0" Background="#C40A0A0C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Macro" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="Keyboard24" FontSize="34"
                                   Foreground="White" Opacity="0.72" />
                </Grid>
                <Border Grid.Row="1" Margin="0,12,0,0" Height="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#CFFFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <ui:CardExpander Margin="0,14,0,0" IsExpanded="False">
            <ui:CardExpander.Header>
                <TextBlock Text="Calibration" FontSize="17" FontWeight="SemiBold" />
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock Text="Primary" FontWeight="SemiBold" Margin="2,0,0,4" />
                <ItemsControl ItemsSource="{Binding PrimaryWeapons}"
                              ItemTemplate="{StaticResource CalibrationWeaponTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Secondary" FontWeight="SemiBold" Margin="2,12,0,4" />
                <ItemsControl ItemsSource="{Binding SecondaryWeapons}"
                              ItemTemplate="{StaticResource CalibrationWeaponTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Melee" FontWeight="SemiBold" Margin="2,12,0,4" />
                <ItemsControl ItemsSource="{Binding MeleeWeapons}"
                              ItemTemplate="{StaticResource CalibrationWeaponTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Utility" FontWeight="SemiBold" Margin="2,12,0,4" />
                <ItemsControl ItemsSource="{Binding UtilityWeapons}"
                              ItemTemplate="{StaticResource CalibrationWeaponTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,10,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <TextBlock Text="Grid loadout" FontSize="17" FontWeight="SemiBold" />
            </ui:CardExpander.Header>
            <StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Text="Primary" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailablePrimary}"
                                  SelectedItem="{Binding SelectedPrimary, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource WeaponChoiceTemplate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,12">
                        <TextBlock Text="Secondary" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableSecondary}"
                                  SelectedItem="{Binding SelectedSecondary, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource WeaponChoiceTemplate}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Text="Melee" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableMelee}"
                                  SelectedItem="{Binding SelectedMelee, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource WeaponChoiceTemplate}" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,12">
                        <TextBlock Text="Utility" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableUtility}"
                                  SelectedItem="{Binding SelectedUtility, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource WeaponChoiceTemplate}" />
                    </StackPanel>
                </UniformGrid>

                <ui:Button Content="{Binding RunButtonText}"
                           Command="{Binding RunGridLoadoutCommand}"
                           Appearance="Primary" HorizontalAlignment="Stretch" Padding="16,10" />
            </StackPanel>
        </ui:CardExpander>

        <Border Margin="0,10,0,0" Padding="18,16" CornerRadius="12"
                Background="#B80A0A0C" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto Rejoin (1hr)" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding AutoRejoinEnabled, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</ui:UiPage>
